@model DocumentationWebApp.Areas.Entry.Models.TableDataViewModel

@{
    ViewData["Title"] = "Table Data";
}

<h1>Library Book Data</h1>

<form method="get" class="mb-3" action="/Entry/Dashboard/TableData">
    <div class="input-group" style="max-width: 300px;">
        <input type="text" name="searchId" value="@Model.SearchId" class="form-control" placeholder="Search BookId..." />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>BookId</th>
            <th>Book Title</th>
            <th>Category</th>
            <th>Available</th>
            <th>Borrowed</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>@book.BookId</td>
                <td>@book.Title</td>
                <td>@book.Category</td>
                <td>@book.Available</td>
                <td>@book.Borrowed</td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex gap-2 mt-3">
    <form method="get" action="/Entry/Dashboard/ExportPdf">
        <input type="hidden" name="searchId" value="@Model.SearchId">
        <button type="submit" class="btn btn-primary">Export to PDF</button>
    </form>

    <form method="get" action="/Entry/Dashboard/ExportExcel">
        <input type="hidden" name="searchId" value="@Model.SearchId" />
        <button type="submit" class="btn btn-success">Export to Excel</button>
    </form>
</div>




